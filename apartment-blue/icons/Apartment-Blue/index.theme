[Icon Theme]
Name=Apartment Blue
Comment=Beveled slate-blue desktop and monochrome toolbar icons
Inherits=Mint-X,Adwaita,hicolor
Example=folder
ScaledDirectories=16x16@2x/places,16x16@2x/devices
Directories=16x16/places,16x16/devices,16x16/actions,scalable/places,scalable/devices,scalable/status,scalable/apps,scalable/mimetypes

[scalable/places]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Places

[scalable/devices]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Devices

[scalable/status]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Status

[scalable/apps]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Applications

[scalable/mimetypes]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=MimeTypes

[16x16/actions]
Size=16
Type=Fixed
Context=Actions

[16x16/places]
Size=16
Type=Fixed
Context=Places

[16x16/devices]
Size=16
Type=Fixed
Context=Devices

[16x16@2x/places]
Size=16
Scale=2
Type=Fixed
Context=Places

[16x16@2x/devices]
Size=16
Scale=2
Type=Fixed
Context=Devices
