[Icon Theme]
Name=Apartment Blue
Comment=Beveled slate-blue desktop and monochrome toolbar icons
Inherits=Mint-X,Adwaita,hicolor
Example=folder
Directories=scalable/places,scalable/devices,scalable/status,scalable/apps,scalable/mimetypes,16x16/actions,16x16/places,16x16/devices

[scalable/places]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Places

[scalable/devices]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Devices

[scalable/status]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Status

[scalable/apps]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=Applications

[scalable/mimetypes]
Size=48
Type=Scalable
MinSize=16
MaxSize=256
Context=MimeTypes

[16x16/actions]
Size=16
Type=Fixed
Context=Actions

[16x16/places]
Size=16
Type=Fixed
Context=Places

[16x16/devices]
Size=16
Type=Fixed
Context=Devices
